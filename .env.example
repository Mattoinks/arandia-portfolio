# Contact form delivery (https://resend.com — free tier is plenty).
# Copy to .env.local and fill in. .env.local is git-ignored.
RESEND_API_KEY=

# Where messages are delivered. Defaults to the email in src/lib/data.ts.
CONTACT_TO_EMAIL=

# Sender, e.g. "ARANDIA.DEV" <hello@yourdomain.com>. Leave empty to use Resend's test sender (onboarding@resend.dev),
# which only delivers to your own Resend account email until you verify a domain.
CONTACT_FROM_EMAIL=
