# Contact form delivery (https://resend.com — free tier is plenty).
# Copy to .env.local and fill in. .env.local is git-ignored.
RESEND_API_KEY=

# Where messages are delivered. Defaults to the email in src/lib/data.ts.
CONTACT_TO_EMAIL=

# Sender, e.g. "ARANDIA.DEV" <hello@yourdomain.com>. Leave empty to use Resend's test sender (onboarding@resend.dev),
# which only delivers to your own Resend account email until you verify a domain.
CONTACT_FROM_EMAIL=

# AI assistant ("Ask about me" chat). Free key at https://console.groq.com → API Keys.
# Without it the chat still works for its suggested questions and hands off to the contact form.
GROQ_API_KEY=

# Optional model override (default: openai/gpt-oss-20b). See console.groq.com/docs/models.
GROQ_MODEL=

# Google Search Console — the code from the "HTML tag" verification method
# (only the content="..." value, not the whole <meta> tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
